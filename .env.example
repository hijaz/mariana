# ── LangSmith (tracing + evaluation) ──────────────────────────────────────────
# Get your API key at https://smith.langchain.com
# With LANGCHAIN_TRACING_V2=true every LangGraph run is traced automatically.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=mariana

# ── Mariana settings (all optional — defaults shown) ──────────────────────────
# The library reads these as environment variables prefixed with MARIANA_.
# Create a local .env file from this example and do not commit it.

# Ollama model names. Pull them locally with Ollama first.
# If you don't have a model already, use a stable small model like gemma3:1b.
MARIANA_PLANNER_MODEL=gemma3:1b
MARIANA_SUMMARIZER_MODEL=gemma3:1b

# Ollama server URL
MARIANA_OLLAMA_BASE_URL=http://localhost:11434

# SearXNG port. If the port is unavailable, Mariana will auto-select a free port.
MARIANA_SEARXNG_PORT=8080

# Research depth controls
MARIANA_MAX_RESULTS=5          # number of search results fetched per sub-question
MARIANA_NUM_SUBQUESTIONS=3     # number of sub-questions generated per planning step
MARIANA_MAX_ITERATIONS=3       # max reflect→replan loops before forcing a report
MARIANA_MAX_PAGE_CHARS=4000    # characters kept per scraped page
MARIANA_SEARCH_DELAY_SECONDS=2.0  # seconds to wait between page fetches to reduce blocking risk

# Where research reports are saved
MARIANA_OUTPUT_DIR=~/.mariana/output
